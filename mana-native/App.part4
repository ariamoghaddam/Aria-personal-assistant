function MissionCard({ mission, onPress }: { mission: Mission; onPress: () => void }) {
  return <Pressable style={[styles.card, styles.missionCard]} onPress={onPress}><View style={styles.row}><Text style={styles.time}>{clock(mission.scheduled_time)}</Text><Text style={styles.badge}>{statusFa(mission.status)}</Text></View><Text style={styles.missionName}>{mission.project?.name || 'پروژه'}</Text><Text style={styles.cardText}>📍 {mission.project?.address || 'بدون آدرس'} · {faDate(mission.project_date)}</Text><View style={styles.chips}><View style={styles.chip}><Text style={styles.chipValue}>{num(mission.concrete_volume_m3)} m³</Text><Text style={styles.chipLabel}>حجم بتن</Text></View><View style={[styles.chip, styles.chipBlue]}><Text style={styles.chipValue}>{mission.service}</Text><Text style={styles.chipLabel}>خدمات</Text></View></View></Pressable>;
}

function MissionDetail({ mission, onBack, onDepart, onArrive, onFinish, finalVolume, setFinalVolume, report, setReport, checklist, pickChecklist, loading }: any) {
  const [finishing, setFinishing] = useState(false);
  const p = mission.project || {};
  async function navigate() {
    if (p.lat == null || p.lng == null) return Alert.alert('مسیریابی', 'موقعیت پروژه ثبت نشده است.');
    const url = Platform.OS === 'ios' ? `http://maps.apple.com/?daddr=${p.lat},${p.lng}` : `geo:${p.lat},${p.lng}?q=${p.lat},${p.lng}(${encodeURIComponent(p.name || 'پروژه')})`;
    await Linking.openURL(url);
  }
  return <SafeAreaView style={styles.safe}><ScrollView contentContainerStyle={styles.content}><Pressable onPress={onBack}><Text style={styles.back}>← بازگشت</Text></Pressable><View style={styles.detailHero}><Text style={styles.detailKicker}>جزئیات مأموریت</Text><Text style={styles.detailName}>{p.name || 'پروژه'}</Text><Text style={styles.detailAddress}>📍 {p.address || 'بدون آدرس'}</Text></View><View style={styles.factGrid}><Fact label="تاریخ پروژه" value={faDate(mission.project_date)} /><Fact label="ساعت حضور" value={clock(mission.scheduled_time)} blue /><Fact label="متراژ بتن" value={`${num(mission.concrete_volume_m3)} m³`} green /><Fact label="خدمات" value={mission.service} /></View><Pressable style={styles.route} onPress={navigate}><Text style={styles.routeTitle}>🧭 مسیریابی به پروژه</Text><Text style={styles.routeSub}>باز کردن مسیر در نقشه گوشی</Text></Pressable><View style={styles.card}><Text style={styles.cardTitle}>📡 GPS مأموریت</Text><Text style={styles.cardText}>{mission.tracking_active ? 'GPS پس‌زمینه فعال است.' : 'با زدن «حرکت کردم» GPS فعال می‌شود.'}</Text></View><View style={styles.timeline}><TimeBox label="حرکت" value={faTime(mission.departed_at)} /><TimeBox label="رسیدن" value={faTime(mission.arrived_at)} /><TimeBox label="اتمام" value={faTime(mission.finished_at)} /></View>{!mission.departed_at && <Pressable style={[styles.primary, { backgroundColor: COLORS.royal }]} onPress={onDepart}><Text style={styles.primaryText}>🚗 حرکت کردم</Text></Pressable>}{mission.departed_at && !mission.arrived_at && <Pressable style={[styles.primary, { backgroundColor: COLORS.teal }]} onPress={onArrive}><Text style={styles.primaryText}>📍 رسیدم پروژه</Text></Pressable>}{mission.arrived_at && mission.status !== 'completed' && <><Pressable style={[styles.primary, { backgroundColor: COLORS.amber }]} onPress={() => Alert.alert('در انتظار پروژه', 'زمان انتظار به‌صورت مستقل ثبت می‌شود.')}><Text style={styles.primaryText}>⏳ در انتظار پروژه</Text></Pressable><Pressable style={[styles.primary, { backgroundColor: COLORS.navy }]} onPress={() => setFinishing(true)}><Text style={styles.primaryText}>✓ اتمام پروژه</Text></Pressable></>}{finishing && <View style={styles.finishBox}><Text style={styles.sectionTitle}>اتمام مأموریت</Text><Text style={styles.label}>حجم نهایی بتن *</Text><TextInput keyboardType="decimal-pad" value={finalVolume} onChangeText={setFinalVolume} style={styles.input} /><Text style={styles.label}>گزارش کتبی / مشکلات *</Text><TextInput multiline value={report} onChangeText={setReport} style={[styles.input, { height: 110, textAlignVertical: 'top' }]} />{mission.service !== 'تنظیم بار' && <Pressable style={styles.upload} onPress={pickChecklist}><Text style={styles.cardTitle}>📷 {checklist ? 'چک‌لیست انتخاب شد ✓' : 'انتخاب تصویر چک‌لیست *'}</Text></Pressable>}<Pressable style={styles.primary} onPress={onFinish} disabled={loading}><Text style={styles.primaryText}>{loading ? 'در حال ثبت...' : 'ثبت و اتمام پروژه'}</Text></Pressable></View>}</ScrollView></SafeAreaView>;
}

function CalendarView({ missions }: { missions: Mission[] }) { return <><SectionTitle title="تقویم کاری من" subtitle="ماموریت‌های ثبت‌شده" />{missions.map(m => <View key={m.id} style={styles.card}><Text style={styles.cardTitle}>{m.project?.name}</Text><Text style={styles.cardText}>{faDate(m.project_date)} · {clock(m.scheduled_time)} · {m.service}</Text></View>)}</>; }
function FinanceView() { return <><View style={styles.financeHero}><Text style={styles.heroTitle}>مالی و اداری</Text><Text style={styles.heroText}>درخواست وام، تنخواه، علی‌الحساب و مرخصی.</Text></View><View style={styles.financeGrid}>{['🏦 درخواست وام','🧾 هزینه مأموریت / تنخواه','💳 علی‌الحساب حقوق','🗓️ درخواست مرخصی'].map(x=><Pressable key={x} style={styles.financeAction} onPress={()=>Alert.alert('مالی و اداری','این بخش به همان گردش مالی پنل مدیریت متصل می‌شود.')}><Text style={styles.financeTitle}>{x}</Text></Pressable>)}</View><SectionTitle title="پاداش / جریمه" /><View style={styles.card}><Text style={styles.cardTitle}>سوابق شخصی کارشناس</Text><Text style={styles.cardText}>اطلاعات واقعی این بخش با جدول مالی پنل مدیریت همگام می‌شود.</Text></View></>; }
function AlertsView() { return <><SectionTitle title="اعلان‌ها" subtitle="ماموریت، مالی، اداری و پیام مدیر" /><View style={styles.card}><Text style={styles.cardTitle}>🔔 Push Native فعال</Text><Text style={styles.cardText}>پس از ثبت توکن دستگاه، اعلان‌ها از سرور مانا به iOS و Android ارسال می‌شوند.</Text></View></>; }

function BottomNav({ tab, setTab }: { tab: Tab; setTab: (t: Tab) => void }) { const items: [Tab,string,string][] = [['home','⌂','خانه'],['missions','▣','ماموریت‌ها'],['calendar','◫','تقویم'],['finance','₮','مالی و اداری'],['alerts','●','اعلان‌ها']]; return <View style={styles.bottom}>{items.map(([key,icon,label],i)=><Pressable key={key} style={[styles.navBtn, tab===key&&styles.navActive]} onPress={()=>setTab(key)}><View style={[styles.navIcon,{backgroundColor:[COLORS.teal,COLORS.royal,COLORS.purple,COLORS.amber,COLORS.red][i]}]}><Text style={styles.navIconText}>{icon}</Text></View><Text style={styles.navLabel}>{label}</Text></Pressable>)}</View>; }
function SectionTitle({ title, subtitle }: any) { return <View style={styles.sectionHead}><Text style={styles.sectionTitle}>{title}</Text>{subtitle&&<Text style={styles.sectionSub}>{subtitle}</Text>}</View>; }
function Fact({ label, value, blue, green }: any) { return <View style={[styles.fact, blue&&styles.factBlue, green&&styles.factGreen]}><Text style={styles.factLabel}>{label}</Text><Text style={styles.factValue}>{value}</Text></View>; }
function TimeBox({ label, value }: any) { return <View style={styles.timeBox}><Text style={styles.factLabel}>{label}</Text><Text style={styles.timeValue}>{value}</Text></View>; }
function Empty({ text }: { text:string }) { return <View style={styles.card}><Text style={[styles.cardText,{textAlign:'center'}]}>{text}</Text></View>; }
function statusFa(s:string){return ({assigned:'جدید',seen:'دیده‌شده',accepted:'پذیرفته‌شده',en_route:'در مسیر',on_site:'در پروژه',completed:'تکمیل شد',cancelled:'لغو شد'} as any)[s]||s;}

const styles = StyleSheet.create({
  safe:{flex:1,backgroundColor:COLORS.bg},center:{flex:1,alignItems:'center',justifyContent:'center',backgroundColor:COLORS.bg},content:{padding:14,paddingBottom:120},loginWrap:{flex:1,backgroundColor:COLORS.bg,justifyContent:'center',padding:20},loginCard:{backgroundColor:COLORS.card,borderRadius:28,padding:22,borderWidth:1,borderColor:COLORS.line},brandRow:{flexDirection:'row-reverse',alignItems:'center',gap:12},logo:{width:56,height:56,borderRadius:18,backgroundColor:COLORS.teal,alignItems:'center',justifyContent:'center'},logoText:{color:'#fff',fontSize:28,fontWeight:'900'},brand:{fontSize:23,fontWeight:'900',color:COLORS.navy,textAlign:'right'},sub:{fontSize:12,color:COLORS.muted,textAlign:'right',marginTop:3},hero:{backgroundColor:COLORS.navy,borderRadius:24,padding:20,marginVertical:12},heroTitle:{fontSize:24,fontWeight:'900',color:'#fff',textAlign:'right'},heroText:{fontSize:14,color:'#EAF8F5',lineHeight:24,textAlign:'right',marginTop:5},label:{fontSize:13,fontWeight:'900',color:COLORS.text,textAlign:'right',marginTop:12,marginBottom:6},input:{backgroundColor:'#fff',borderColor:COLORS.line,borderWidth:1,borderRadius:12,paddingHorizontal:13,paddingVertical:12,fontSize:16,textAlign:'right'},primary:{borderRadius:14,padding:15,marginTop:12,backgroundColor:COLORS.teal,alignItems:'center'},primaryText:{fontSize:16,fontWeight:'900',color:'#fff'},topbar:{height:78,backgroundColor:'#EEF3F4',flexDirection:'row-reverse',alignItems:'center',paddingHorizontal:14,gap:10,borderBottomWidth:1,borderBottomColor:COLORS.line},logout:{backgroundColor:COLORS.red,borderRadius:10,paddingHorizontal:12,paddingVertical:8},logoutText:{color:'#fff',fontWeight:'900'},smartRow:{flexDirection:'row-reverse',gap:9},smart:{flex:1,backgroundColor:'#EFF3F4',borderRadius:18,padding:14,borderWidth:1,borderColor:COLORS.line},smartGreen:{backgroundColor:'#D7F2EB'},smartTitle:{fontWeight:'900',fontSize:16,color:COLORS.navy,textAlign:'right'},smartText:{fontSize:12,color:COLORS.muted,textAlign:'right',marginTop:5},sectionHead:{marginTop:20,marginBottom:10},sectionTitle:{fontSize:21,fontWeight:'900',color:COLORS.text,textAlign:'right'},sectionSub:{fontSize:12,color:COLORS.muted,textAlign:'right',marginTop:3},card:{backgroundColor:COLORS.card,borderRadius:19,padding:16,borderWidth:1,borderColor:COLORS.line,marginBottom:10},missionCard:{borderRightWidth:6,borderRightColor:COLORS.teal},row:{flexDirection:'row',justifyContent:'space-between',alignItems:'center'},time:{fontSize:23,fontWeight:'900',color:COLORS.royal},badge:{fontSize:11,fontWeight:'900',backgroundColor:'#87DFCF',color:'#075F55',paddingHorizontal:9,paddingVertical:6,borderRadius:8},missionName:{fontSize:21,fontWeight:'900',textAlign:'right',color:COLORS.navy,marginTop:10},cardTitle:{fontSize:14,fontWeight:'900',textAlign:'right',color:COLORS.navy},cardText:{fontSize:12,color:COLORS.muted,textAlign:'right',lineHeight:21,marginTop:4},chips:{flexDirection:'row-reverse',gap:7,marginTop:10},chip:{flex:1,backgroundColor:'#CCEEE5',borderRadius:12,padding:10},chipBlue:{backgroundColor:'#DDE6EF',flex:1.4},chipValue:{fontSize:14,fontWeight:'900',color:COLORS.navy,textAlign:'right'},chipLabel:{fontSize:10,color:COLORS.muted,textAlign:'right',marginTop:3},bottom:{position:'absolute',left:10,right:10,bottom:10,height:84,backgroundColor:COLORS.navy,borderRadius:25,flexDirection:'row-reverse',padding:6},navBtn:{flex:1,alignItems:'center',justifyContent:'center',borderRadius:16},navActive:{backgroundColor:'#FFFFFF18'},navIcon:{width:39,height:39,borderRadius:13,alignItems:'center',justifyContent:'center'},navIconText:{color:'#fff',fontSize:19,fontWeight:'900'},navLabel:{color:'#DCE6E9',fontSize:10,fontWeight:'800',marginTop:3},back:{fontSize:14,fontWeight:'900',color:COLORS.royal,textAlign:'right',marginBottom:10},detailHero:{backgroundColor:COLORS.navy,borderRadius:22,padding:20},detailKicker:{fontSize:11,fontWeight:'900',color:'#9FF6E8',textAlign:'right'},detailName:{fontSize:30,fontWeight:'900',color:'#fff',textAlign:'right',marginTop:3},detailAddress:{fontSize:14,color:'#E8F6F4',textAlign:'right',marginTop:6},factGrid:{flexDirection:'row-reverse',flexWrap:'wrap',gap:8,marginTop:10},fact:{width:'48.5%',backgroundColor:'#fff',borderRadius:14,padding:12,borderWidth:1,borderColor:COLORS.line},factBlue:{backgroundColor:'#E4EAF5'},factGreen:{backgroundColor:'#D7F2EB'},factLabel:{fontSize:10,color:COLORS.muted,textAlign:'right',fontWeight:'800'},factValue:{fontSize:17,fontWeight:'900',color:COLORS.navy,textAlign:'right',marginTop:4},route:{backgroundColor:COLORS.royal,borderRadius:15,padding:15,marginTop:10},routeTitle:{fontSize:16,fontWeight:'900',color:'#fff',textAlign:'right'},routeSub:{fontSize:10,color:'#E5EDFB',textAlign:'right',marginTop:4},timeline:{flexDirection:'row-reverse',gap:7,marginTop:10},timeBox:{flex:1,backgroundColor:'#fff',borderWidth:1,borderColor:COLORS.line,borderRadius:12,padding:10,alignItems:'center'},timeValue:{fontSize:13,fontWeight:'900',color:COLORS.navy,marginTop:4},finishBox:{marginTop:15,backgroundColor:'#EEF3F4',borderRadius:18,padding:14,borderWidth:1,borderColor:COLORS.line},upload:{backgroundColor:'#F7FAFB',borderWidth:1,borderStyle:'dashed',borderColor:'#8EAAA8',borderRadius:12,padding:13,marginTop:12},financeHero:{backgroundColor:COLORS.navy,borderRadius:22,padding:18},financeGrid:{flexDirection:'row-reverse',flexWrap:'wrap',gap:9,marginTop:12},financeAction:{width:'48.5%',backgroundColor:COLORS.card,borderRadius:16,padding:16,borderWidth:1,borderColor:COLORS.line,minHeight:90,justifyContent:'center'},financeTitle:{fontSize:14,fontWeight:'900',color:COLORS.navy,textAlign:'right'}
});